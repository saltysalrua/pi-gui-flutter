{
  "profiles": {
    "my-openai-gateway": {
      "baseUrl": "https://api.example.com/v1",
      "api": "openai-responses",
      "apiKey": "$MY_GATEWAY_KEY",
      "modelRules": [
        { "match": ["claude"], "transform": "claude-responses", "reasoning": true }
      ],
      "models": [
        { "id": "gpt-5", "contextWindow": 400000, "maxTokens": 128000 },
        { "id": "internal-alias", "manual": true },
        { "id": "text-embedding-3-large", "disabled": true }
      ]
    },
    "anthropic-direct": {
      "baseUrl": "https://api.anthropic.com/v1",
      "api": "anthropic-messages",
      "apiKey": "!pass show anthropic/api-key"
    },
    "local-llama": {
      "baseUrl": "http://127.0.0.1:8080/v1",
      "api": "openai-completions",
      "syncModels": false,
      "models": [{ "id": "llama-3.3-70b", "manual": true, "reasoning": false }]
    }
  }
}
