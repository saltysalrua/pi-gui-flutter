{
  "active": "my-openai-gateway",
  "profiles": {
    "my-openai-gateway": {
      "baseUrl": "https://api.example.com/v1",
      "api": "openai-responses",
      "apiKey": "$MY_GATEWAY_KEY",
      "reasoning": false,
      "modelRules": [
        { "match": ["gpt-5", "o3"], "reasoning": true },
        { "match": ["claude"], "transform": "claude-responses", "reasoning": true }
      ],
      "models": [
        { "id": "gpt-5", "contextWindow": 400000, "maxTokens": 128000 },
        { "id": "claude-sonnet-4-5", "input": ["text", "image"] }
      ],
      "defaultModel": "gpt-5"
    },
    "anthropic-direct": {
      "baseUrl": "https://api.anthropic.com",
      "api": "anthropic-messages",
      "apiKey": "!pass show anthropic/api-key",
      "reasoning": true,
      "models": [
        { "id": "claude-opus-4-1" }
      ]
    }
  }
}
